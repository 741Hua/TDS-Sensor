# =================
# Kicad Git Ignore
# =================

# Local user-specific settings and window layouts (do not share)
*.kicad_prl
*.kicad_user
fp-info-cache

# Automatic backup files generated by Kicad
*-backups/
*-bak
*.bak
*.bck
*.sch-bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.history/

# Autosave recovery files
_autosave-*
*.autosave

# Lock files (temporary files open while editing)
*.lck

# =========================================================================
# Optional: Manufacturing & Output Files
# =========================================================================
# Un-comment the lines below if you do want to block Gerbers or BOMs from Git.
# (Highly recommended: only commit Gerbers when tagging a final production release)

# Gerber/Drill output directories (common folder names)
/JLC_Gerbers/

# Bill of Materials and position files
*.csv
*.xml
*.pos